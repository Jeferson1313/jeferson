unit Unit2;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.Layouts,
  FMX.StdCtrls, FMX.Objects, FMX.Controls.Presentation, FMX.Effects, System.IOUtils,
  Unit3, System.Permissions, FMX.Platform,
  Androidapi.JNI.GraphicsContentViewText, Androidapi.JNI.JavaTypes,
  Androidapi.JNIBridge, Androidapi.Helpers, System.Generics.Collections;

const
  CARD_WIDTH_RATIO = 240;
  CARD_HEIGHT_RATIO = 430;
  CARD_ASPECT_RATIO = CARD_WIDTH_RATIO / CARD_HEIGHT_RATIO;
  MIN_CARD_WIDTH = 200;
  TOTAL_PADDING_HORIZONTAL = 40;

type
  TForm2 = class(TForm)
    ScrollBox1: TScrollBox;
    FlowLayout1: TFlowLayout;
    Layout2: TLayout;
    Layout3: TLayout;
    Image1: TImage;
    Layout4: TLayout;
    Text1: TText;
    Layout5: TLayout;
    Text2: TText;
    procedure FormResize(Sender: TObject);
    procedure FormShow(Sender: TObject);
  private
    { Declarações privadas }
    procedure ClearExistingCards;
    procedure CalculateCardMetrics(CardCount: Integer; out CardWidth, CardHeight: Single; out Columns: Integer);
    procedure CreateAndPlaceCards(const CardCount: Integer; const CardWidth, CardHeight: Single; const Columns: Integer);
    procedure CreateDynamicCards(const CardCount: Integer);
    function GetImagesPath: string;
    procedure CopyAssetsToDocuments;
    function CopyAssetFile(const AssetFileName, DestPath: string): Boolean;
  public
    { Declarações públicas }
  end;

var
  Form2: TForm2;

implementation

{$R *.fmx}

function TForm2.GetImagesPath: string;
begin
  // No Android, usamos a pasta interna do app (Documents)
  Result := TPath.GetDocumentsPath + PathDelim;
end;

procedure TForm2.CopyAssetsToDocuments;
var
  AssetsPath: string;
  DestPath: string;
  Files: TStringDynArray;
  I: Integer;
begin
  try
    AssetsPath := TPath.GetDocumentsPath + PathDelim;
    DestPath := GetImagesPath;

    // Garante que o diretório destino existe
    ForceDirectories(DestPath);

    // Lista de arquivos que devem ser copiados (ajuste conforme seus arquivos)
    Files := TDirectory.GetFiles(AssetsPath, '*.*',
      function(const Path: string; const SearchRec: TSearchRec): Boolean
      begin
        Result := (Pos('.jpg', LowerCase(SearchRec.Name)) > 0) or
                 (Pos('.jpeg', LowerCase(SearchRec.Name)) > 0) or
                 (Pos('.png', LowerCase(SearchRec.Name)) > 0) or
                 (Pos('.bmp', LowerCase(SearchRec.Name)) > 0);
      end);

    // Copia arquivos da pasta assets para documents
    for I := 0 to High(Files) do
    begin
      try
        if not FileExists(DestPath + ExtractFileName(Files[I])) then
        begin
          TFile.Copy(Files[I], DestPath + ExtractFileName(Files[I]));
        end;
      except
        on E: Exception do
        begin
          // Log do erro (pode ser removido em produção)
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      // Tratamento de erro silencioso
    end;
  end;
end;

function TForm2.CopyAssetFile(const AssetFileName, DestPath: string): Boolean;
var
  InputStream: JInputStream;
  OutputStream: JFileOutputStream;
  Buffer: TJavaArray<Byte>;
  BytesRead: Integer;
  FileName: JString;
  JAssetFileName: JString;
begin
  Result := False;
  try
    // Converte o nome do arquivo para JString
    JAssetFileName := StringToJString(AssetFileName);

    // Obtém o asset manager
    InputStream := TAndroidHelper.Context.getAssets.open(JAssetFileName);
    try
      // Cria o arquivo de destino
      FileName := StringToJString(DestPath + AssetFileName);
      OutputStream := TJFileOutputStream.JavaClass.init(FileName);

      // Buffer para cópia
      Buffer := TJavaArray<Byte>.Create(1024);
      try
        BytesRead := InputStream.read(Buffer);
        while BytesRead > 0 do
        begin
          OutputStream.write(Buffer, 0, BytesRead);
          BytesRead := InputStream.read(Buffer);
        end;
        Result := True;
      finally
        Buffer.Free;
        OutputStream.close;
      end;
    finally
      InputStream.close;
    end;
  except
    on E: Exception do
    begin
      Result := False;
    end;
  end;
end;

procedure TForm2.ClearExistingCards;
begin
  while FlowLayout1.ControlsCount > 0 do
    FlowLayout1.Controls[0].Free;
end;

procedure TForm2.CalculateCardMetrics(CardCount: Integer; out CardWidth, CardHeight: Single; out Columns: Integer);
var
  AvailableWidth: Single;
  GapH: Single;
begin
  GapH := FlowLayout1.HorizontalGap;
  AvailableWidth := ScrollBox1.Width;

  if AvailableWidth < 100 then
    AvailableWidth := Form2.Width;

  AvailableWidth := AvailableWidth - TOTAL_PADDING_HORIZONTAL;

  if (AvailableWidth - GapH) / 2 < MIN_CARD_WIDTH then
    Columns := 1
  else
    Columns := 2;

  CardWidth := (AvailableWidth - (Columns - 1) * GapH) / Columns;
  if CardWidth < 1 then
    CardWidth := AvailableWidth;

  CardHeight := CardWidth / CARD_ASPECT_RATIO;
  if CardHeight < 150 then
    CardHeight := 150;
end;

procedure TForm2.CreateAndPlaceCards(const CardCount: Integer; const CardWidth, CardHeight: Single; const Columns: Integer);
var
  i: Integer;
  Frame: TFrame3;
  Rows: Integer;
  TotalHeight: Single;
  GapV: Single;
  ImageFiles: TArray<string>;
  ImagePath, FileName: string;
begin
  GapV := FlowLayout1.VerticalGap;
  ImagePath := GetImagesPath;

  // Lê os arquivos de imagem da pasta documents
  try
    if TDirectory.Exists(ImagePath) then
      ImageFiles := TDirectory.GetFiles(ImagePath, '*.*',
        function(const Path: string; const SearchRec: TSearchRec): Boolean
        begin
          Result := (Pos('.jpg', LowerCase(SearchRec.Name)) > 0) or
                   (Pos('.jpeg', LowerCase(SearchRec.Name)) > 0) or
                   (Pos('.png', LowerCase(SearchRec.Name)) > 0) or
                   (Pos('.bmp', LowerCase(SearchRec.Name)) > 0);
        end)
    else
      SetLength(ImageFiles, 0);
  except
    on E: Exception do
      SetLength(ImageFiles, 0);
  end;

  // Ordena os arquivos para garantir ordem consistente
  TArray.Sort<string>(ImageFiles);

  // Cria os frames dinamicamente
  for i := 1 to CardCount do
  begin
    Frame := TFrame3.Create(nil);
    Frame.Parent := FlowLayout1;

    Frame.Align := TAlignLayout.None;
    Frame.Width := CardWidth;
    Frame.Height := CardHeight;

    // 🔹 Tenta carregar imagem correspondente
    if (Length(ImageFiles) >= i) and (i - 1 <= High(ImageFiles)) then
    begin
      try
        FileName := ExtractFileName(ImageFiles[i - 1]);

        // Define o texto do label
        if Assigned(Frame.Label1) then
          Frame.Label1.Text := ChangeFileExt(FileName, '');

        // Carrega a imagem
        if Assigned(Frame.Image1) then
        begin
          try
            // Usa LoadThumbnailFromFile para melhor performance no Android
            Frame.Image1.Bitmap.LoadThumbnailFromFile(ImageFiles[i - 1],
              Round(CardWidth), Round(CardHeight));
          except
            // Fallback para método normal
            try
              Frame.Image1.Bitmap.LoadFromFile(ImageFiles[i - 1]);
            except
              // Fallback para imagem padrão
              Frame.Image1.Bitmap.Clear(TAlphaColorRec.Gray);
              if Assigned(Frame.Label1) then
                Frame.Label1.Text := 'Imagem ' + IntToStr(i);
            end;
          end;
        end;
      except
        on E: Exception do
        begin
          // Em caso de erro, usa placeholder
          if Assigned(Frame.Label1) then
            Frame.Label1.Text := 'Card ' + IntToStr(i);
          if Assigned(Frame.Image1) then
            Frame.Image1.Bitmap.Clear(TAlphaColorRec.Lightgray);
        end;
      end;
    end
    else
    begin
      // 🔹 Placeholder quando não há imagem
      if Assigned(Frame.Label1) then
        Frame.Label1.Text := 'Card ' + IntToStr(i);

      if Assigned(Frame.Image1) then
        Frame.Image1.Bitmap.Clear(TAlphaColorRec.Lightgray);
    end;
  end;

  // Ajuste de layout
  FlowLayout1.RecalcSize;

  Rows := (CardCount + Columns - 1) div Columns;
  TotalHeight := (Rows * CardHeight) + ((Rows - 1) * GapV) + 20;

  if TotalHeight < ScrollBox1.ClientHeight then
    TotalHeight := ScrollBox1.ClientHeight;

  FlowLayout1.Height := TotalHeight;
  ScrollBox1.Align := TAlignLayout.Client;
end;

procedure TForm2.CreateDynamicCards(const CardCount: Integer);
var
  CardWidth, CardHeight: Single;
  Columns: Integer;
begin
  if not Assigned(FlowLayout1) or not Assigned(ScrollBox1) then
    Exit;

  ClearExistingCards;
  CalculateCardMetrics(CardCount, CardWidth, CardHeight, Columns);
  CreateAndPlaceCards(CardCount, CardWidth, CardHeight, Columns);
end;

procedure TForm2.FormShow(Sender: TObject);
begin
  // Copia imagens dos assets para documents na primeira execução
  CopyAssetsToDocuments;

  // Pequeno delay para garantir que os arquivos foram copiados
  TThread.CreateAnonymousThread(
    procedure
    begin
      TThread.Sleep(100);
      TThread.Synchronize(nil,
        procedure
        begin
          CreateDynamicCards(8);
        end
      );
    end
  ).Start;
end;

procedure TForm2.FormResize(Sender: TObject);
begin
  if Assigned(FlowLayout1) and (FlowLayout1.Controls.Count > 0) then
  begin
    CreateDynamicCards(FlowLayout1.Controls.Count);
  end;
end;

end.
